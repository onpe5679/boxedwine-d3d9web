# ===== boxedwine-d3d9web =====================================================
# Everything below is a deliberate "never commit" list.  Prebuilt binaries are
# distributed as GitHub Release assets instead (see RELEASE_ASSETS.md).

# --- build outputs ---------------------------------------------------------
/project/emscripten/Build/
/project/emscripten/*.wasm
/project/emscripten/boxedwine.*.js
/d3d9web/guest/out/
/d3d9web/**/*.obj
/d3d9web/**/*.dll
/d3d9web/**/*.exe
/d3d9web/**/*.map
/d3d9web/**/*.lib
/d3d9web/**/*.exp
/d3d9web/**/*.pdb
/d3d9web/**/*.ilk
*.wasm

# --- app / guest-filesystem / profile packages (contain game data or large blobs)
/apps/
/fs/
/profiles/
/project/emscripten/*.zip
/d3d9web/**/*.zip

# --- game assets: never commit -----------------------------------------------
/Data/
*.wmb
*.mdl
*.pcx
*.wis
*.tga
*.ogg
*.mp3
*.wmv

# --- logs, captures, dumps ---------------------------------------------------
*.log
*.err
*.dmp
/logs/
/captures/
/artifacts/

# --- local tooling / state ---------------------------------------------------
/emsdk/
__pycache__/
*.pyc
.omc/
.claude/
node_modules/
.env
.env.*
*.pfx
*.pem
*.key

