 DWORD WINAPI DECLSPEC_HOTPATCH WaitForSingleObject( HANDLE handle, DWORD timeout )
 {
+#ifdef AZROK_BOXEDWINE_WAIT_MARKER
+    const void *caller = __builtin_return_address(0);
+    DWORD result;
+
+    azrok_boxedwine_wait_marker( 1, timeout, caller, (ULONG_PTR)handle );
+    azrok_wait_marker_depth++;
+    result = WaitForSingleObjectEx( handle, timeout, FALSE );
+    azrok_wait_marker_depth--;
+    azrok_boxedwine_wait_marker( 2, timeout, caller, result );
+    return result;
+#else
     return WaitForSingleObjectEx( handle, timeout, FALSE );
+#endif
 }
 
 
