+#ifdef AZROK_BOXEDWINE_WAIT_MARKER
+/*
+ * Local measurement ABI for the Azrok BoxedWine build. The private high number
+ * 0x7f00 is intercepted before BoxedWine's Linux syscall table. The production
+ * Wine build does not define this flag.
+ */
+static __thread unsigned int azrok_wait_marker_depth;
+
+static inline void azrok_boxedwine_wait_marker( DWORD phase, DWORD timeout,
+                                                const void *caller, ULONG_PTR value )
+{
+#if defined(__i386__)
+    register ULONG result __asm__("eax") = 0x7f00;
+
+    __asm__ volatile ("int $0x80"
+                      : "+a" (result)
+                      : "b" (phase), "c" (timeout), "d" ((ULONG_PTR)caller), "S" (value)
+                      : "cc", "memory");
+#else
+    (void)phase;
+    (void)timeout;
+    (void)caller;
+    (void)value;
+#endif
+}
+#endif
